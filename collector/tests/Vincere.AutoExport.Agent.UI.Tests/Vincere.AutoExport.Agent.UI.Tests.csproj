<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- The attribution engine AttributionExport calls. Referenced as a project
         rather than listed file by file below: it is netstandard2.0, builds
         everywhere, and has its own suite. -->
    <ProjectReference Include="../../src/Vincere.AutoExport.NinjaTrader.Core/Vincere.AutoExport.NinjaTrader.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/ControlPipeClient.cs" Link="ControlPipeClient.cs" />
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/MainViewModel.cs" Link="MainViewModel.cs" />
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/CaptureDayView.cs" Link="CaptureDayView.cs" />
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/QuarantineView.cs" Link="QuarantineView.cs" />
    <!-- Named one by one rather than referencing the UI project, because that
         project is WPF and does not build everywhere this suite runs. A new file
         the view model uses has to be added here or the tests stop compiling,
         which is how CI caught this one. -->
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/ReleaseCheck.cs" Link="ReleaseCheck.cs" />
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/DeepExport/SecretRedactor.cs" Link="DeepExport/SecretRedactor.cs" />
    <!-- The identity rule for the exported config. Compiled rather than
         referenced so its internal ProjectWith is reachable: there is no
         secret-named field on its keep list, so the only way to watch that guard
         fire is to hand the same code path a policy that has one. -->
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/DeepExport/AgentConfigProjection.cs" Link="DeepExport/AgentConfigProjection.cs" />
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/DeepExport/TraceRedactor.cs" Link="DeepExport/TraceRedactor.cs" />
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/DeepExport/DeepExportSources.cs" Link="DeepExport/DeepExportSources.cs" />
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/DeepExport/StrategyUserdataRedactor.cs" Link="DeepExport/StrategyUserdataRedactor.cs" />
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/DeepExport/SqliteSnapshot.cs" Link="DeepExport/SqliteSnapshot.cs" />
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/DeepExport/AttributionExport.cs" Link="DeepExport/AttributionExport.cs" />
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/DeepExport/DeepExportRunner.cs" Link="DeepExport/DeepExportRunner.cs" />
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/DeepExport/NinjaTraderFolder.cs" Link="DeepExport/NinjaTraderFolder.cs" />
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/OfflineReportWriter.cs" Link="OfflineReportWriter.cs" />
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/StrategyConfigurationRedactor.cs" Link="StrategyConfigurationRedactor.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The DeepExport sources as TEXT beside the test binary, so
         TheAllowlistIsStatedInExactlyOnePlace can count the table allowlist
         instead of trusting that there is still only one of it. A WILDCARD on
         purpose: a new file here must be scanned without anybody remembering to
         add it, because a hand-maintained list would be the same drift the test
         exists to catch. These files are also compiled above; being in both
         Compile and None is fine. -->
    <None Include="../../src/Vincere.AutoExport.Agent.UI/DeepExport/*.cs"
          Link="allowlist-scan/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- AND THE TWO FILES OUTSIDE DeepExport/ THAT COULD RESTATE A RULE, for
         EveryRuleAboutWhatShipsIsStatedOnce. The strategy-configuration rule has
         two callers - the Desktop report and the Deep Export - and it lived as a
         private method in the first of them until the second appeared. Named
         rather than wildcarded because this project's root is not the scan's
         subject; a third caller must be added here deliberately. -->
    <None Include="../../src/Vincere.AutoExport.Agent.UI/StrategyConfigurationRedactor.cs"
          Link="allowlist-scan/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Vincere.AutoExport.Agent.UI/OfflineReportWriter.cs"
          Link="allowlist-scan/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
