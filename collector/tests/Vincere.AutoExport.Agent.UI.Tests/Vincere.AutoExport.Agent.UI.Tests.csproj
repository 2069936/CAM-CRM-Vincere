<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- THE DEEP EXPORT, AS A REFERENCE AT LAST.
         These ten files used to be named one at a time below, because they lived
         in the WPF project and that project does not build everywhere this suite
         runs. They are now their own net8.0 library, which is the whole reason
         the suite can say this in one line instead of ten paths that drift. It
         brings NinjaTrader.Core - the attribution engine AttributionExport calls
         - with it, so that reference is gone from here too. -->
    <ProjectReference Include="../../src/Vincere.AutoExport.DeepExport/Vincere.AutoExport.DeepExport.csproj" />
    <!-- The tests build their own fixture database and read the shipped copy
         back, so this one is theirs and not inherited. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/ControlPipeClient.cs" Link="ControlPipeClient.cs" />
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/MainViewModel.cs" Link="MainViewModel.cs" />
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/CaptureDayView.cs" Link="CaptureDayView.cs" />
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/QuarantineView.cs" Link="QuarantineView.cs" />
    <!-- Named one by one rather than referencing the UI project, because that
         project is WPF and does not build everywhere this suite runs. A new file
         the view model uses has to be added here or the tests stop compiling,
         which is how CI caught this one. -->
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/ReleaseCheck.cs" Link="ReleaseCheck.cs" />
    <!-- Stays a link: it anchors the report bundle to its own assembly's folder
         (typeof(OfflineReportWriter).Assembly.Location + /OfflineReport), and
         that bundle is Content in the WPF csproj. It is a Desktop-report
         concern, not an export one, and it did not move. -->
    <Compile Include="../../src/Vincere.AutoExport.Agent.UI/OfflineReportWriter.cs" Link="OfflineReportWriter.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The deep export sources as TEXT beside the test binary, so
         TheAllowlistIsStatedInExactlyOnePlace can count the table allowlist
         instead of trusting that there is still only one of it. A WILDCARD on
         purpose: a new file there must be scanned without anybody remembering to
         add it, because a hand-maintained list would be the same drift the test
         exists to catch. These files are also compiled into the referenced
         project; being in both is fine.

         THE GLOB NOW COVERS StrategyConfigurationRedactor.cs TOO, because that
         file moved into the deep export project along with the nine it is a
         dependency of. It used to be named separately below, as a file outside
         the scanned folder. The scan's subject is now a project rather than a
         folder, which is a better fit for what the rule is about: a second
         statement of what ships, anywhere in the code that decides it.

         DeepExportSourceFiles names every file it expects to find here, and that
         is not belt and braces. Measured: with the old count floor, an item list
         that stops reaching exactly one source leaves all 155 tests green, and
         the single-statement tests then count their rules over a smaller set and
         still see one of each. Nothing in the build notices either. -->
    <None Include="../../src/Vincere.AutoExport.DeepExport/*.cs"
          Link="allowlist-scan/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- AND THE ONE FILE OUTSIDE THAT PROJECT THAT COULD RESTATE A RULE, for
         EveryRuleAboutWhatShipsIsStatedOnce. The strategy-configuration rule has
         two callers - the Desktop report and the Deep Export - and it lived as a
         private method in the first of them until the second appeared. Named
         rather than wildcarded because the WPF project is not the scan's subject;
         a third caller there must be added here deliberately. -->
    <None Include="../../src/Vincere.AutoExport.Agent.UI/OfflineReportWriter.cs"
          Link="allowlist-scan/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
