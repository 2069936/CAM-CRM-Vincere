<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Kept in step with the service and with the release tag. The window
         reads the service's version over the control pipe and this is only the
         answer before the pipe replies, but a fallback that is wrong by two
         releases is how the window came to report 1.0.0 forever. -->
    <Version>1.1.3</Version>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- THE CRM'S REPORT CODE, BUILT BY THE CRM'S OWN VITE.
         scripts/build_offline_report_bundle.mjs writes this, and the Setup
         window inlines it into every local report it produces. It ships as
         content rather than being generated here on purpose: the machine has
         no Node, so the bundle has to arrive already built. -->
    <Content Include="OfflineReport/report-bundle.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Vincere.AutoExport.Contracts/Vincere.AutoExport.Contracts.csproj" />
    <!-- THE DEEP EXPORT, WHICH USED TO BE A FOLDER IN HERE.
         MainViewModel still owns the button and still constructs the
         Progress<DeepExportProgress> that marshals each report back onto this
         window's thread. Only the ten files behind it moved down a layer, so that
         the service can reach them too. NinjaTrader.Core and Microsoft.Data.Sqlite
         went with them - they were here for the export and nothing left in this
         project uses either directly - and they still arrive in the publish
         output through this reference. -->
    <ProjectReference Include="../Vincere.AutoExport.DeepExport/Vincere.AutoExport.DeepExport.csproj" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
</Project>
