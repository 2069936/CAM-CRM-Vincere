<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- THE NUMBER THE ADDON REPORTS ABOUT ITSELF.
         Every snapshot's source.addonVersion is this assembly's own version,
         read at capture time (VincereAutoExportAddOn.cs), and the status window
         and the CRM's client card show it. Undeclared until now, it was the SDK
         default, which is why the whole fleet reports addon 1.0.0 whatever it is
         running: an AddOn built last quarter and one built today are
         indistinguishable on the screen a CAM looks at, and a capture that
         arrives without strategy attribution cannot be told from one whose
         machine simply has no strategies.
         This release is the one that attributes orders and fills to the strategy
         that placed them, so the version has to say so. Keep it in step with the
         agent and with the release tag; the installer ships both from the same
         collector-v tag. -->
    <Version>1.1.0</Version>
    <TargetFramework>net48</TargetFramework>
    <NinjaTraderHome Condition="'$(NinjaTraderHome)' == '' and '$(NINJATRADER_HOME)' != ''">$(NINJATRADER_HOME)</NinjaTraderHome>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Vincere.AutoExport.Contracts/Vincere.AutoExport.Contracts.csproj" />
    <ProjectReference Include="../Vincere.AutoExport.NinjaTrader.Core/Vincere.AutoExport.NinjaTrader.Core.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="NinjaTrader.Core">
      <HintPath>$(NinjaTraderHome)\bin\NinjaTrader.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NinjaTrader.Gui">
      <HintPath>$(NinjaTraderHome)\bin\NinjaTrader.Gui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NinjaTrader.NinjaScript">
      <HintPath>$(NinjaTraderHome)\bin\NinjaTrader.NinjaScript.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequireNinjaTraderHome" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(NinjaTraderHome)' == '' or !Exists('$(NinjaTraderHome)\bin\NinjaTrader.Core.dll')"
      Text="Set NINJATRADER_HOME to the NinjaTrader 8 installation directory; proprietary DLLs must remain outside the repository." />
  </Target>
</Project>
