{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/report/pdf.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/assets/(.*).woff2",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
